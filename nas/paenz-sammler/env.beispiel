# Kopie als "einstellungen.env" speichern und ausfüllen. Diese Datei NIE ins Repo hochladen.
# Gruppennamen genau wie in WhatsApp, mit ; getrennt
GRUPPEN=Kita Sonnenschein Eltern;Nippes Familien;Krabbelgruppe Niehl
# Empfänger der Sammelmail (deine Gmail-Adresse)
MAIL_AN=deine.adresse@gmail.com
# Gmail-Konto, das die Mail verschickt, und sein App-Passwort (16 Zeichen, Leerzeichen egal)
SMTP_USER=deine.adresse@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# Uhrzeit der Sammelmail (vor dem Morgenlauf um 06:16)
SENDEZEIT=05:30
# Optional: größte Datei (Bild/PDF) in MB, die geladen wird; größere stehen nur als Hinweis in der Mail
# MAX_DATEI_MB=15
